@{
    ViewBag.Title = "Create Vendor Registration";

}
<style>
    .bs-example {
        margin: 10px;
    }
</style>
@using (Html.BeginForm("Create", "VendorMaster", FormMethod.Post, new { @class = "form-horizontal", role = "Vendform", enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div align="right">
        <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
            @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
        </p>
    </div>
    <div class="bs-example">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item"><a href="#tabs-1" class="nav-link text-primary active" data-toggle="tab">1-Company Profile</a></li>
            <li class="nav-item"><a href="#tabs-2" class="nav-link text-primary" data-toggle="tab">2-Financial Details</a></li>
            <li class="nav-item"><a href="#tabs-3" class="nav-link text-primary" data-toggle="tab">3-Credentials and Address</a></li>
            <li class="nav-item"><a href="#tabs-4" class="nav-link text-primary" data-toggle="tab">4-Manufacturing Detail</a></li>
        </ul>
        <fieldset>
            <div class="tab-content">
                <div id="tabs-1" class="tab-pane fade show active">
                    <div class="content-wrapper">
                        <div class="container-scroller">
                            <div class="card border-0 col-md-12 mb-1">
                                <div class="card-body">
                                    <div class="form-horizontal">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        @Html.Label("Name", "Name of the Firm:", htmlAttributes: new { @class = "control-label " })
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("Name", null, new { @id = "Name", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("Name", "", new { @class = "text-danger small font-weight-bold" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        @Html.Label("ESTdate", "Date of Establishment:", htmlAttributes: new { @class = "control-label " })
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("ESTdate", null, new { @id = "ESTdate",  @class = "form-control form-control-sm", @autocomplete = "Off" })
                                                        @Html.ValidationMessage("ESTdate", "", new { @class = "text-danger small font-weight-bold" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label">Name of Contact Person:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("NameContact", null, new { @id = "NameContact", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("NameContact", "", new { @class = "text-danger small font-weight-bold" })
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                                                Contact Details
                                            </p>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label">Address</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextArea("Address", null, new { @id = "Address", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("Address", "", new { @class = "text-danger small font-weight-bold" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label ">Country</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.DropDownList("CountryMaster_Id", ViewBag.CountryMaster_Id as SelectList, "-Country-", htmlAttributes: new { @id = "CountryMaster_Id", @class = "form-control form-control-sm", @autocomplete = "off" })
                                                        @Html.ValidationMessage("CountryMaster_Id", "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label ">State</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.DropDownList("StateMaster_Id", ViewBag.StateMaster_Id as SelectList, "-Select-", new { @id = "StateMaster_Id", @class = "form-control form-control-sm" })
                                                        <div id="StateName">@Html.TextBox("StateName", null, new { @id = "StateName", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })</div>
                                                        @Html.ValidationMessage("CountryMaster_Id", "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label">City</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("City", null, new { @id = "City", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("City", "", new { @class = "text-danger small font-weight-bold" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">PinCode</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("PinCode", null, new { @id = "PinCode", @class = "form-control form-control-sm", @autocomplete = "Off" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid PinCode</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Mobile No1</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("MobileNo", null, new { @id = "MobileNo", @class = "form-control form-control-sm", @type = "number", @autocomplete = "Off" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid Mobile No</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Mobile No2</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("MobileNo2", null, new { @id = "MobileNo2", @class = "form-control form-control-sm", @type="number", @autocomplete = "Off" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid Mobile No</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Office No</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("OfficeNo", null, new { @id = "OfficeNo", @class = "form-control form-control-sm", @type = "number", @autocomplete = "Off" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Email ID1</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("EmailId1", null, new { @id = "EmailId1", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid email</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Email ID2</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("EmailId", null, new { @id = "EmailId", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid email</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">PAN No.</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("PAN", null, new { @id = "PAN", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter Valid PAN No.</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">GST NO/W.E.F</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("GST", null, new { @id = "GST", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid GST No.</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                                                Type of the Firm:
                                                <label class="text-danger control-label" id="lblChk">*</label>
                                                <span class="error">Please select atleast one checkbox</span>
                                            </p>
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <div class="col-sm-12 checkbox-wrapper">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeFirmCB1" id="TypeFirmCB1" value="true">
                                                            <label class="form-check-label" for="TypeFirmCB1">1.Limited</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeFirmCB2" id="TypeFirmCB2" value="true">
                                                            <label class="form-check-label" for="TypeFirmCB2">2.Private Limited</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeFirmCB3" id="TypeFirmCB3" value="true">
                                                            <label class="form-check-label" for="TypeFirmCB3">3.Proprietory</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeFirmCB4" id="TypeFirmCB4" value="true">
                                                            <label class="form-check-label" for="TypeFirmCB4">4.Partnership</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeFirmCB5" id="TypeFirmCB5" value="true">
                                                            <label class="form-check-label" for="TypeFirmCB5">5.Govt. Org</label>
                                                        </div>
                                                      
                                                    </div>
                                                </div>
                                               
                                            </div>
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                                                Type of Business:
                                            </p>
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <div class="col-sm-12 checkbox-wrapper">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeBusCB1" id="TypeBusCB1" value="true">
                                                            <label class="form-check-label" for="TypeBusCB1">1.Auth. Dealer</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeBusCB2" id="TypeBusCB2" value="true">
                                                            <label class="form-check-label" for="TypeBusCB2">2.Trader</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeBusCB3" id="TypeBusCB3" value="true">
                                                            <label class="form-check-label" for="TypeBusCB3">3.Sub-Contractor (IH/OS)</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeBusCB4" id="TypeBusCB4" value="true">
                                                            <label class="form-check-label" for="TypeBusCB4">4.Service</label>
                                                        </div>
                                                        <div class="form-check form-check-inline m-2">
                                                            <input class="form-check-input" type="checkbox" name="TypeBusCB5" id="TypeBusCB5" value="true">
                                                            <label class="form-check-label" for="TypeBusCB5">5.Manufacturing</label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" name="TypeBusCB6" id="TypeBusCB6" value="true">
                                                            <label class="form-check-label" for="TypeBusCB6">6.Others (Specify)</label>
                                                            @Html.TextBox("OthrText", null, new { @id = "OthrText", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase", @disabled = "disabled" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                          
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                                                Management Details:(CEO/MD)
                                            </p>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Name:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("NameMD", null, new { @id = "NameMD", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("NameMD", "", new { @class = "text-danger small font-weight-bold" })
                                                    
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Contact No:</label>
                                                        <label class="text-danger control-label">*</label> 
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("ContactNoMD", null, new { @id = "ContactNoMD", @class = "form-control form-control-sm", @autocomplete = "Off", @type = "number" })
                                                        @Html.ValidationMessage("ContactNoMD", "", new { @class = "text-danger small font-weight-bold" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid Contact No</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">EMailID:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("EMailIDMD", null, new { @id = "EMailIDMD", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("EMailIDMD", "", new { @class = "text-danger small font-weight-bold" })
                                                       
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                                                Quality Head Details:
                                            </p>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Name:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("NameQT", null, new { @id = "NameQT", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("NameQT", "", new { @class = "text-danger small font-weight-bold" })
                                           
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <div class="row col-md-12">
                                                        <label class="control-label">Contact No:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("ContactNoQT", null, new { @id = "ContactNoQT", @class = "form-control form-control-sm", @autocomplete = "Off", @type = "number"})
                                                        @Html.ValidationMessage("ContactNoQT", "", new { @class = "text-danger small font-weight-bold" })
                                                        <span class="error">Required</span>
                                                        <span class="valid">Enter valid Contact No</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label">EMailID:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.TextBox("EMailIDQT", null, new { @id = "EMailIDQT", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        @Html.ValidationMessage("EMailIDQT", "", new { @class = "text-danger small font-weight-bold" })
                                                      
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-12">
                                        <div class="col-md-offset-6 col-md-12" align="center">
                                            <input type="button" id="btn_Nxt1" value="Next" class="btn btn-sm  btn-outline-primary col-sm-1 font" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tabs-2" class="tab-pane fade">
                    <div class="content-wrapper">
                        <div class="container-scroller">
                            <div class="card border-0 col-md-12 mb-1">
                                <div class="card-body">
                                    <div class="form-horizontal">
                                        <div class="row">
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                                                Sales Turnover (Last three Financial Year)
                                            </p>
                                            <div class="table-responsive font m-2">
                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Year 1</th>
                                                            <th>Year 2</th>
                                                            <th>Year 3</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>@Html.TextBox("Year1", null, new { @id = "Year1", @class = "form-control form-control-sm", @autocomplete = "Off" })</td>
                                                            <td>@Html.TextBox("Year2", null, new { @id = "Year2", @class = "form-control form-control-sm", @autocomplete = "Off" })</td>
                                                            <td>@Html.TextBox("Year3", null, new { @id = "Year3", @class = "form-control form-control-sm", @autocomplete = "Off" })</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <div class="row  col-md-12">
                                                        <label class="control-label">Currency:</label>
                                                        <label class="text-danger control-label">*</label>
                                                    </div>
                                                    <div class="col-md-12 row">
                                                        @Html.DropDownList("CRMaster_Id", ViewBag.CRMaster_Id as SelectList, "-Select-", htmlAttributes: new { @id = "CRMaster_Id", @class = "form-control form-control-sm", @autocomplete = "off" })
                                                        @Html.ValidationMessage("CRMaster_Id", "", new { @class = "text-danger small font-weight-bold" })
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="col-sm-12 border-left-success bg-whiteDark" align="left" style="margin-top:10px;padding:5px;" id="MSMEdivHead">
                                                MSME Industries:
                                                <label class="text-danger control-label" id="lblMsME">*</label>
                                                <span class="error">Please select Yes/No</span>
                                            </p>
                                            <div class="row" id="MSMEdiv">
                                                <div class="col-sm-4">
                                                    <div class="form-group">
                                                        <div class="col-sm-12 checkbox-wrapper">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="checkbox" name="MsMECBMI1" id="MsMECBMI1" value="true">
                                                                <label class="form-check-label" for="MsMECBMI1">Yes</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="checkbox" name="MsMECBMI2" id="MsMECBMI2" value="true">
                                                                <label class="form-check-label" for="MsMECBMI2">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-8">
                                                    <div class="row">
                                                        <div class="col-sm-4">
                                                            @Html.Label("AttachMents:", "MSME Doc:", htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-sm-10">
                                                            <input type="file" id="MSMEDoc" name="SuppDocRel[0].MSMEDoc" class="form-control form-control-sm h-90" accept="application/pdf,image/png,image/jpeg" />
                                                            <span class="error">Required</span>
                                                        </div>
                                                    </div>
