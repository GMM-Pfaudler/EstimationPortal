@model IEnumerable<SUP_CORE.DTO.VendDTO>
@{
    ViewBag.Title = "Index List";
    string uname = Session["UserName"].ToString();
    string BMailID = "";
    int? RId = Convert.ToInt32(Session["RoleID"].ToString());
    if (RId == 4)
    {
        BMailID = Session["EmailID"].ToString();
    }
}
<div id="content">
    <!-- Begin Page Content -->
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card border-0 mb-4">
            <div class="card-body">
                <p class="col-sm-2 border-left-primary bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                    @Html.ActionLink("Create New", "Create", null, new { @class = "text-primary" })
                </p>
                <div class="table-responsive font">
                    <table class="table" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr class="text-nowrap small">
                                <th>Actions</th>
                                <th>Firm</th>
                                <th>Date Of Establishment</th>
                                <th>Contact Person</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr class="nowrap small">
                                    @if (item.CreatedBy == uname && RId == 9)
                                    {//for vendor test
                                        if (item.SID != 2)
                                        {
                                            <td>
                                                @Html.ActionLink("Edit", "Edit", "VendorMaster", new { id = item.Id }, new { @class = "text-primary" }) |
                                                @Html.ActionLink("Delete", "Delete", "VendorMaster", new { id = item.Id }, new { @class = "text-danger" })
                                            </td>
                                        }
                                        else { <td></td>}

                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Convert.ToDateTime(item.ESTdate).ToString("dd-MMM-yyyy")</td>
                                        <td>@Html.DisplayFor(modelItem => item.NameContact)</td>
                                        if (item.SID == 1)
                                        {<td class="rounded-bgp">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else if (item.SID == 2)
                                        {<td class="rounded-bga">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else if (item.SID == 3)
                                        {<td class="rounded-bgr">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else {<td></td> }
                                    }
                                    else if (RId == 1)
                                    {//for admin
                                        <td>
                                            @Html.ActionLink("Edit", "Edit", "VendorMaster", new { id = item.Id }, new { @class = "text-primary" }) |
                                            @Html.ActionLink("Delete", "Delete", "VendorMaster", new { id = item.Id }, new { @class = "text-danger" })
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Convert.ToDateTime(item.ESTdate).ToString("dd-MMM-yyyy")</td>
                                        <td>@Html.DisplayFor(modelItem => item.NameContact)</td>
                                        if (item.SID == 1)
                                        {<td class="rounded-bgp">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else if (item.SID == 2)
                                        {<td class="rounded-bga">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else if (item.SID == 3)
                                        {<td class="rounded-bgr">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else
                                        { <td></td> }
                                    }
                                    else if (RId == 4 && item.BEmail == BMailID)
                                    {//for buyer
                                        <td>
                                            @Html.ActionLink("View", "View", "VendorMaster", new { id = item.Id }, new { @class = "text-primary" })
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Convert.ToDateTime(item.ESTdate).ToString("dd-MMM-yyyy")</td>
                                        <td>@Html.DisplayFor(modelItem => item.NameContact)</td>
                                        if (item.SID == 1)
                                        { <td class="rounded-bgp">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else if (item.SID == 2)
                                        { <td class="rounded-bga">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else if (item.SID == 3)
                                        { <td class="rounded-bgr">@Html.DisplayFor(modelItem => item.Status)</td> }
                                        else
                                        { <td></td> }
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

 <style>
     .rounded-bgp { 
    border-radius: 10px;
    background-color: #FFCC00;
    color: #FFFFFF;
    padding: 10px;
    display: inline-block;
    }

     .rounded-bga { 
    border-radius: 10px;
    background-color: #5cb85c;
    color: #FFFFFF;
    padding: 10px;
    display: inline-block;
    }

     .rounded-bgr { 
    border-radius: 10px;
    background-color: #ff0000;
    color: #FFFFFF;
    padding: 10px;
    display: inline-block;
    }
 </style>
@section scripts
{
    <script>
        $(document).ready(function () {
            $('#dataTable thead tr').clone(true).appendTo('#dataTable thead');
            $('#dataTable thead tr:eq(1) th').each(function (i) {
                var title = $(this).text();
                $(this).html('<input type="text" placeholder="Search ' + title + '" />');

                $('input', this).on('keyup change', function () {
                    if (table.column(i).search() !== this.value) {
                        table
                            .column(i)
                            .search(this.value)
                            .draw();
                    }
                });
            });
            var table = $('#dataTable').DataTable({
                destroy: true,
                orderCellsTop: true,
                "columnDefs": [
                    { "width": "20%", "targets": 1 }

                ],
                "order": [[1, "asc"]],
                "lengthMenu": [[10, 15, 25, 50, 100, -1], [10, 15, 25, 50, 100, "All"]],
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        exportOptions: {
                            columns: [1, 2]
                        },
                        filename: function () {
                            var d = new Date().toISOString().split('T')[0];
                            return 'Summary_' + d;
                        }
                    }
                ]


            });
        });
    </script>
}