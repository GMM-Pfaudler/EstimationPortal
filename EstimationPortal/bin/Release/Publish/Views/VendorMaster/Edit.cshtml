                                                                <td></td>
                                                            </tr>
                                                            <tr>
                                                                <td>E-mail: </td>
                                                                <td colspan="2">@Html.TextBox("ERPEmailId3", null, new { @id = "ERPEmailId3", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })</td>
                                                                <td></td>
                                                                <td></td>
                                                                <td></td>
                                                            </tr>
                                                            <tr>
                                                                <td>GST No / W.E.F.</td>
                                                                <td colspan="5">@Html.TextBox("ERPGST3", null, new { @id = "ERPGST3", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })</td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-12">
                                        <div class="col-md-offset-6 col-md-12" align="center">
                                            <input type="button" id="btn_PreV3" value="Previous" class="btn btn-sm  btn-outline-info col-sm-1 font" />
                                            <input type="button" id="btn_Nxt3" value="Next" class="btn btn-sm  btn-outline-primary col-sm-1 font" />

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="tabs-4" class="tab-pane fade">
                        <div class="content-wrapper">
                            <div class="container-scroller">
                                <div class="card border-0 col-md-12 mb-1">
                                    <div class="card-body">
                                        <div class="form-horizontal">
                                            <div class="row">
                                                <div class="table-responsive font">
                                                    <table class="table table-bordered" id="tblSuppMD" cellspacing="0">
                                                        <thead>
                                                            <tr class="text-nowrap">
                                                                <th></th>
                                                                <th class="small font-weight-bold">Sr_No</th>
                                                                <th class="small font-weight-bold">Code(Type)</th>
                                                                <th class="small font-weight-bold">Products Dealt In</th>
                                                                <th class="small font-weight-bold">Max Size / Weight</th>
                                                                <th class="small font-weight-bold">Grade/Make</th>
                                                                <th class="small font-weight-bold">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="text-nowrap small">
                                                            @foreach (var item in Model.SupRelMDTrs.Where(s => s.IsDelete == false))
                                                            {
                                                                <tr id="tblSuppMD_@countMD">
                                                                    <td>

                                                                        <input type="hidden" name="SupRelMDTrs[@countMD].IsDelete" value="false" id="IsDeleteC_@countMD" />
                                                                        <input type="hidden" name="SupRelMDTrs[@countMD].Size" value="@item.Size" />
                                                                        <input type="hidden" name="SupRelMDTrs[@countMD].Id" value="@item.Id" />
                                                                        <input type="hidden" name="SupRelMDTrs[@countMD].Grade" value="@item.Grade" />
                                                                        <input type="hidden" name="SupRelMDTrs[@countMD].PDI" value="@item.PDI" />
                                                                        <input type="hidden" name="SupRelMDTrs[@countMD].CodeList" value="@item.CodeList" />
                                                                    </td>
                                                                    <td>@(countMD + 1)</td>
                                                                    <td>@item.CodeList</td>
                                                                    <td>@item.PDI</td>
                                                                    <td>@item.Size</td>
                                                                    <td>@item.Grade</td>
                                                                    <td><a data-itemId="0" href="#" class="btn btn-sm btn-outline-danger" onclick="FnRemoveSD(@countMD);"><i class="fa fa-trash" aria-hidden="true"></i></a></td>
                                                                </tr>
                                                                countMD++;
                                                            }
                                                        </tbody>
                                                        <tfoot>
                                                            <tr>
                                                                <td></td>
                                                                <td></td>
                                                                <td>
                                                                    @Html.DropDownList("CodeList", ViewBag.CodeType as SelectList, "-Select-", htmlAttributes: new { @class = "form-control form-control-sm" })
                                                                    <span class="error">Required</span>
                                                                </td>
                                                                <td>
                                                                    <input type="text" name="PDI" id="PDI" class="form-control form-control-sm h-50" autocomplete="off" style = "text-transform:uppercase"/>
                                                                    <span class="error">Required</span>
                                                                </td>
                                                                <td>
                                                                    <input type="text" name="Size" id="Size" class="form-control form-control-sm h-50" autocomplete="off" style = "text-transform:uppercase" />
                                                                    <span class="error">Required</span>
                                                                </td>
                                                                <td>
                                                                    <input type="text" name="Grade" id="Grade" class="form-control form-control-sm h-50" autocomplete="off" style = "text-transform:uppercase"/>
                                                                    <span class="error">Required</span>
                                                                </td>
                                                                <td class="small"><input type="button" onclick="AddMD()" class="btn btn-success" style="height:40px; width:60px" value="Add" /></td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                                 
                                                            @Html.Hidden("BEmail", null, new { @id = "BEmail", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase" })
                                                        
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <div class="row  col-md-12">
                                                            <label class="control-label">Buyer's Remarks</label> 
                                                        </div>
                                                        <div class="col-md-12 row">
                                                            @Html.TextAreaFor(model => model.BRemarks, new { @id = "SRemarks", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "text-transform:uppercase", @readonly = "readonly" })
                                                         </div>
                                                    </div>
                                                </div>
                                                <div class="form-group col-sm-12 m-md-2" align="center">
                                                    <input type="button" id="btn_PreV4" value="Previous" class="btn btn-sm  btn-outline-info col-sm-1 font" />
                                                     <input type="submit"  id="btnSubmit" value="Update" class="btn btn-sm  btn-outline-success col-sm-1 font" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
@section scripts
{
   <style>
    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 70%;
    }

    span.valid {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 70%;
    }

    tr.error {
        background-color: rgba(255,0,0,0.35);
    }
</style>

    <script type="text/javascript">
        var counter = 0;
        if (@count > 0)
        {
            counter  = @count;
        }
        let counterMD = 0;
        if (@countMD > 0)
        {
            counterMD  = @countMD;
        }
    </script>
    <script src="~/Scripts/ProjectScripts/VendorEdit.js"></script>
}


