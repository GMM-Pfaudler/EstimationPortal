@model SUP_CORE.EFModel.POUpload
@{
    ViewBag.Title = "Import Drawing";

}
@using (Html.BeginForm("UploadPO", "DrawingMaster", FormMethod.Post, new { @enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
                </p>
            </div>
            <div class="card border-0">
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-5 border-left-primary bg-whiteDark">
                            <div class="form-group">
                                <div class="row" style="margin-top:5px;">
                                    <div class="col-md-3">
                                        @Html.Label("Item Code", "Item Code", htmlAttributes: new { @class = "control-label " })
                                        <label class="text-danger control-label">*</label>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="row">
                                            @Html.TextBox("ItemCode", null, new { @id = "ItemCode", @class = "form-control form-control-sm",@autocomplete="off" })
                                            @Html.ValidationMessage("ItemCode", "", new { @class = "text-danger small font-weight-bold" })
                                         </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1"></div>
                        <div class="col-md-6 border-left-primary bg-whiteDark">
                            <div class="form-group ">
                                <div class="row" style="margin-top:5px;">
                                    <div class="col-md-3">
                                        <div class="control-label font-weight-bold">Upload PDF File:</div>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="file" id="FileUpload" name="FileUpload" class="col-md-8" />
                                        <input type="submit" name="Submit" value="Upload" class="btn btn-sm btn-outline-primary col-sm-3 font" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
