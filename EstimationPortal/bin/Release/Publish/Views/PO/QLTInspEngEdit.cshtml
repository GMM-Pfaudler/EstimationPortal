@section scripts
{
    <script>
        $(document).ready(function () {
            $("#RejID").prop("disabled", true);

            $("#QtyRework").val(0);
            $("#QtyReject").val(0);
            $("#QtyUse").val(0);
            $("#QtyAccRJ").blur(function () {
                debugger
                let QtyACpVl = $("#QtyAccRJ option:selected").val();
                let QtyRework = parseFloat($("#QtyRework").val());
                if (QtyACpVl == "Partial" && QtyRework<1)
                {
                    alert("Rework Qty must be enter!")
                }
            });
            $("#QLTInspStatus").change(function () {
                debugger
                //let QtyOffVl = parseFloat($("#Qty_Offered").val());
                //let QtyApprove = parseFloat($("#QtyUse").val());
                //let QtyReject = parseFloat($("#QtyReject").val());
                //let QtyRework = parseFloat($("#QtyRework").val());
                //let total = QtyApprove + QtyReject + QtyRework;
                //if (total != QtyOffVl)
                //{
                //    alert("Qty Approved/Rejected/Rework not matched with offered qty!")
                //}
                let Status = $("#QLTInspStatus option:selected").val();
                if (Status == "Accepted")
                { 
                   // var intvalue = Math.trunc($("#Qty_Offered").val());
                    var intvalue = $("#Qty_Offered").val();
                    $("#QtyUse").val(intvalue);
                    $("#QtyReject").val(0);
                    $("#QtyRework").val(0);
                    $("#RejID").prop("disabled", true);
                    $("#RejID").val(0).attr("selected", "selected");
                }
                else if (Status == "Rejected") {
                    //var intvalue = Math.trunc($("#Qty_Offered").val());
                    var intvalue = $("#Qty_Offered").val();
                    $("#QtyUse").val(0);
                    $("#QtyReject").val(intvalue);
                    $("#QtyRework").val(0);
                    $("#RejID").prop("disabled", false);
                }
                else if (Status == "Rework")
                {
                    $("#QtyUse").val(0);
                    $("#QtyReject").val(0);
                    $("#QtyRework").val(0);
                    $("#RejID").prop("disabled", false);
                }
                

            });

            $("#QtyAccRJ").change(function () {
                let QtyACpVl = $("#QtyAccRJ option:selected").val();
                if (QtyACpVl == "true") {
                    let QtyOffVl = $("#Qty_Offered").val();
                    $("#QtyUse").val(QtyOffVl);
                    $("#QtyReject").val('0'); 
                    $("#QtyRework").val('0'); 
                }
                else if (QtyACpVl == "false") {
                    $("#QtyUse").val(0);
                    $("#QtyUse").setAttribute('readonly', true);
                }
                else {
                    $("#QtyUse").val("");
                    $("#QtyUse").setAttribute('readonly', false);
                }
            });
            $("#QtyUse").blur(function () {
                let QtyVl = $("#QtyUse").val();
                let QtyOffVl = $("#Qty_Offered").val();
                if (parseFloat(QtyVl) > parseFloat(QtyOffVl)) {
                    alert("Qty Should not greater then offered qty!")
                    $("#QtyUse").val("");
                }
                else {

                }
            });
        });
    </script>
}