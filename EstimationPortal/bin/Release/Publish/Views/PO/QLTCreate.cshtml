@using DocManagement.Models;
@model IEnumerable<SUP_CORE.EFModel.QLT_PODetailsTrs>
@{
    ViewBag.Title = "Create Supplier Inspection Offer";
}
@using (Html.BeginForm("QLTCreate", "PO", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "QLTIndex", null, new { @class = "text-primary" })
                </p>
            </div>
            @*<img src="~/Images/um.jpeg" />*@
            <!-- DataTales Example -->
            <div class="card shadow mb-4 border-0">
                <div class="card-body bg-white"> 
                    <div class="card border-0 col-md-12 mb-1">
                        <div class="card-body">
                            <div class="table-responsive font">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <input type="hidden" id="hfRowIndex" value="" />
                                        <table id="tblCustomers" class="table table-bordered small"  cellspacing="0" width="100%">
                                            <thead>
                                                <tr class="text-nowrap min-vw-100">
                                                    <th>Id</th> 
                                                    <th>OrdNo</th>
                                                    <th>LineNo</th>
                                                    <th>Item</th>
                                                    <th>Description</th>
                                                    <th>DwNo</th>
                                                    <th>RevNo</th>
                                                    <th>Offered Qty</th>
                                                    <th>Remarks</th>
                                                    <th>Attachment</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (SUP_CORE.EFModel.QLT_PODetailsTrs qltpodetails in Model)
                                                {
                                                    <tr>
                                                        <td>@qltpodetails.Id</td>
                                                        <td>@qltpodetails.Order_Number</td>
                                                        <td>@qltpodetails.Line_Number</td>
                                                        <td>@qltpodetails.Item</td>
                                                        <td>@qltpodetails.Description</td>
                                                        <td>@qltpodetails.Drawing_Number</td>
                                                        <td>@qltpodetails.Revision_Number</td>
                                                        <td>@qltpodetails.Qty_Offered</td>
                                                        <td>@qltpodetails.Supp_Remarks</td>
                                                        <td>@qltpodetails.GMM_Drw_Numbr</td> 
                                                        <td><input type="button" value="Remove" class="btn btn-danger" onclick="Remove(this)" /></td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td>@Html.TextBox("Id", null, new { @id = "Id", @class = "form-control form-control-sm", @autocomplete = "off", @readonly = "readonly", @hidden = "true" })</td>
                                                    <td>@Html.TextBox("Order_Number", null, new { @id = "Order_Number", @class = "form-control form-control-sm", @autocomplete = "off" })</td>
                                                    <td>@Html.DropDownList("Line_Number", Enumerable.Empty<SelectListItem>(), "-Select-", new { @id = "Line_Number", @class = "form-control form-control-sm" })</td>
                                                    <td>@Html.TextBox("Item", null, new { @id = "Item", @class = "form-control form-control-sm", @autocomplete = "off", @readonly = "readonly" })</td>
                                                    <td>@Html.TextBox("Description", null, new { @id = "Description", @class = "form-control form-control-sm", @autocomplete = "off", @readonly = "readonly" })</td>
                                                    <td>@Html.TextBox("Drawing_Number", null, new { @id = "Drawing_Number", @class = "form-control form-control-sm", @autocomplete = "off" })</td>
                                                    <td>@Html.TextBox("Revision_Number", null, new { @id = "Revision_Number", @class = "form-control form-control-sm", @autocomplete = "off", @readonly = "readonly" })</td>
                                                    <td>@Html.TextBox("Qty_Offered", null, new { @id = "Qty_Offered", @class = "form-control form-control-sm", @autocomplete = "off", @type = "number" })</td>
                                                    <td>@Html.TextArea("Supp_Remarks", null, new { @id = "Supp_Remarks", @class = "form-control form-control-sm", @autocomplete = "off" })</td>
                                                    <td><input type="file" id="Proof2" name="Proof2" class="form-control" />@Html.Hidden("PQty", null, new { @id = "PQty", @class = "form-control form-control-sm", @autocomplete = "off", @readonly = "readonly", })</td>
                                                    <td><input type="button" id="btnAdd" value="Add" class="btn btn-success" style="width:85px;"/></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @{Html.RenderPartial("_Loading");}
                    <div class="form-group col-md-12">
                        <div class="col-md-offset-2 col-md-12" align="center">
                            <input type="button" id="btnSave" value="Save All" class="btn btn-sm  btn-outline-primary col-sm-2 font" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts
{
    <style>
        span.error {
            display: block;
            visibility: hidden;
            color: red;
            font-size: 70%;
        }

        tr.error {
            background-color: rgba(255,0,0,0.35);
        }
    </style>

 <link rel="stylesheet" href="https://code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="http://ajax.cdnjs.com/ajax/libs/json2/20110223/json2.js"></script>

<link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css"> 
<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>
    <script>
        let counter = 0; 
        $(document).ready(function () {
            $("#Order_Number").autocomplete({
                source: function (request, response) {
                    debugger
                    $.ajax({
                        url: "/PO/AutoGetPONoList",
                        data: { Prefix: request.term.toUpperCase() },
                        dataType: "json",
                        type: "POST",
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Order_Number, value: item.Order_Number };
                            }))
                        }
                    })
                },
                select: function (e, i) {
                    $("#Order_Number").val(i.item.val);
                },
                minLength: 1
            });
            $("#Order_Number").change(function () {
               
                DropBindingLineNoList(); 
            });
            $("#Line_Number").change(function () {
                BindingItemDescList(); 
            });

         
        });
        function DropBindingSequenceList() {
            let OrdNumber = $("#Order_Number").val();
            $.get("/PO/GetSequenceList", { OrdNumber: OrdNumber },
            function (result) {
                $("#Sequence").empty().append('<option selected="selected" value="0">-Select-</option>');
                $.each(result.data, function (index, row) {
                    $("#Sequence").append("<option value='" + row.Value + "'>" + row.Text + "</option>");
                });
            });
            $("#Sequence").ready();
        };
        function DropBindingLineNoList()
        {
            debugger
            let OrdNumber = $("#Order_Number").val();
            $.get("/PO/GetLineNoList", { OrdNumber: OrdNumber },
            function (result) {
                $("#Line_Number").empty().append('<option selected="selected" value="0">-Select-</option>');
                $.each(result.data, function (index, row) {
                    $("#Line_Number").append("<option value='" + row.Value + "'>" + row.Text + "</option>");
                });
            });
            $("#Line_Number").ready();
        };

        function BindingItemDescList() {
            debugger
            let LineId = $("#Line_Number option:selected").val();
            $.ajax({
                type: "POST",
                url: '/PO/GetLineDetails',
                data: { 'LineId': LineId },
                success: function (result) {
                    if (result.data != "") {
                        $("#Item").val(result.data1);
                        $("#Description").val(result.data2);
                        $("#Drawing_Number").val(result.data3);
                        $("#Qty_Offered").val(result.data4);
                        $("#Revision_Number").val(result.data5);
                        $("#PQty").val(result.data4);
                    }
                    else {
                        alert("Data Not Found");
                    }
                }
            });
             
        };
        
        
    </script>
    
<script type="text/javascript"> 
    $("#Qty_Offered").blur(function () {
        debugger
        var QtyOffer =  parseFloat($("#Qty_Offered").val(), 10);
        var PendingQty = parseFloat($("#PQty").val(), 10);
        if (QtyOffer > PendingQty)
        {
            alert("Error : Offered QTY is exceed to pending QTY!");
            $("#Qty_Offered").val("");
        }
    });


    $("body").on("click", "#btnAdd", function () {
        var first = "1";
        var added = "0";
        var Line_Numberval = $("#Line_Number").val();
        var OfferQTY = $("#Qty_Offered").val();

        if (Line_Numberval != null && Line_Numberval != "" && Line_Numberval != "0" && OfferQTY != "" && added != "1")
        {
            $("#tblCustomers TBODY TR").each(function () 
            {//CHECK IF PO IS ALREADY EXSIST OR NOT?
                first = "0";
                var row = $(this); 
               debugger
               if (Line_Numberval == row.find("TD").eq(0).html()) {
                   alert("Error : SAME PO EXSIST!");
                   added = "1";
               }
               //else if (first == "0")
               //{
               //    InsertData();
               //}
                 
            });
            debugger
            if (added == "0")
            {
                InsertData();
                added = "1";
            }
        }
        else { alert("Error : Please fill data first"); }
            
            
        });

    function InsertData()
    {
        debugger
        var Order_Number = $("#Order_Number");
        var Line_Number = $("#Line_Number");
        var Item = $("#Item");
        var Description = $("#Description");
        var Drawing_Number = $("#Drawing_Number");
        var Revision_Number = $("#Revision_Number");
        var Qty_Offered = $("#Qty_Offered");
        var Supp_Remarks = $("#Supp_Remarks");
        var Proof2 = $("#Proof2");
        let Line_NumberTxt = $("#Line_Number option:selected").text();
        var fileUpload = $("#Proof2").get(0);
        var files = fileUpload.files;
        var fileData = new FormData();
        fileData.append(files[0].name, files[0]);
        $.ajax({
            url: '/PO/uploadQLTFile',
            type: 'post',
            datatype: 'json',
            contentType: false,
            processData: false,
            async: false,
            data: fileData,
            success: function (response) {
                alert(response);
            }
        });

        var tBody = $("#tblCustomers > TBODY")[0];
        var row = tBody.insertRow(-1);

        var cell = $(row.insertCell(-1));
        cell.html(Line_Number.val());

        cell = $(row.insertCell(-1));
        cell.html(Order_Number.val());

        cell = $(row.insertCell(-1));
        cell.html(Line_NumberTxt);

        cell = $(row.insertCell(-1));
        cell.html(Item.val());

        cell = $(row.insertCell(-1));
        cell.html(Description.val());

        cell = $(row.insertCell(-1));
        cell.html(Drawing_Number.val());

        cell = $(row.insertCell(-1));
        cell.html(Revision_Number.val());

        cell = $(row.insertCell(-1));
        cell.html(Qty_Offered.val());

        cell = $(row.insertCell(-1));
        cell.html(Supp_Remarks.val());

        cell = $(row.insertCell(-1));
        cell.html(Proof2.val());

        cell = $(row.insertCell(-1));
        var btnRemove = $("<input />");
        btnRemove.attr("type", "button");
        btnRemove.attr("onclick", "Remove(this);");
        btnRemove.attr("class", "btn btn-danger");
        btnRemove.attr("style", "width:85px;");
        btnRemove.val("Remove");
        cell.append(btnRemove);

        Order_Number.val("");
        Line_Number.val("");
        Item.val("");
        Description.val("");
        Drawing_Number.val("");
        Revision_Number.val("");
        Qty_Offered.val("");
        Supp_Remarks.val(""); 
        Proof2.val("");
        $("#Proof2").val("");
        $("#Proof2").val('');
    }

        function Remove(button) {
            var row = $(button).closest("TR");
            var name = $("TD", row).eq(0).html();
            if (confirm("Do you want to delete: " + name)) {
                var table = $("#tblCustomers")[0];
                table.deleteRow(row[0].rowIndex);
            }
        };

        $("body").on("click", "#btnSave", function () {
            $("#imgLoading").show();
            $("#btnSave").hide(); 
            var customers = new Array();
            debugger
            $("#tblCustomers TBODY TR").each(function () {
                var row = $(this);
                var customer = {}; 
                customer.Id = row.find("TD").eq(0).html();
                customer.Order_Number = row.find("TD").eq(1).html();
                customer.Line_Number = row.find("TD").eq(2).html();
                customer.Item = row.find("TD").eq(3).html();
                customer.Description = row.find("TD").eq(4).html();
                customer.Drawing_Number = row.find("TD").eq(5).html();
                customer.Revision_Number = row.find("TD").eq(6).html();
                customer.Qty_Offered = row.find("TD").eq(7).html();
                customer.Supp_Remarks = row.find("TD").eq(8).html();
                customer.GMM_Drw_Numbr = row.find("TD").eq(9).html();

                customers.push(customer);
            });

            $.ajax({
                type: "POST",
                url: "/PO/InsertQLT",
                data: JSON.stringify(customers),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (r) {
                    alert(r + " record(s) inserted.");
                    window.location.href = '/PO/QLTIndex'; 
                },
                error : function () {
                    $("#imgLoading").hide();
                    $("#btnSave").show(); 
                    alert("Error: Something wrong!");
                }
            });
        });
</script> 
}