@using DocManagement.Models;
@model IEnumerable<SUP_CORE.DTO.QLT_PODTO>
@{
    ViewBag.Title = "Quality Inspection Details";
}
@using (Html.BeginForm("QLTInspBulk", "PO", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "QLTInspIndex", null, new { @class = "text-primary" })
                </p>
            </div>
            <!-- DataTales Example -->
            <div class="card shadow mb-4 border-0">
                <div class="card-body bg-white">
                    
                    <table border="0" cellspacing="2" cellpadding="2" class="mx-auto w-auto">
                        <tbody>
                            <tr>
                                <td>QC Remarks</td>
                                <td>@Html.TextArea("QLT_Remarks", null, new { @id = "QLT_Remarks", @class = "form-control form-control-sm", @autocomplete = "off" })</td>
                                <td>@Html.DropDownList("EngId", ViewBag.EngList as SelectList, "-Select IEng-", new { @id = "EngId", @class = "form-control form-control-sm" })</td>
                                <td>Insp. Planned Date</td>
                                <td>@Html.TextBox("InspPlannedDate", null, new { @id = "InspPlannedDate", @class = "form-control form-control-sm", @autocomplete = "Off", @style = "background-color: #FFF;" })</td>
                                <td>
                                    <input type="button" id="BulkSubmit" value="Submit All" class="btn btn-sm  btn-outline-primary  " />
                                    <input type="button" id="BulkWaiver" value="Waiver All" class="btn btn-sm  btn-outline-warning  " /> 
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div id="myPartialDash">
                        @{Html.RenderPartial("_PObulkSummry", Model);}
                    </div>
                </div>
            </div>
        </div>
    </div>
}

