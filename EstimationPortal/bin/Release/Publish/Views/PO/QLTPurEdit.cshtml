@model SUP_CORE.EFModel.QLT_PODetailsTrs
@{
    ViewBag.Title = "Edit Purchase Inspection Details";
}

@using (Html.BeginForm("QLTPurEdit", "PO", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
