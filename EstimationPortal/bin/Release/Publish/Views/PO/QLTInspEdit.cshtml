@section scripts
{
    <script>
        $(document).ready(function () {
              
            var currentDate = new Date();
            $('#InspPlannedDate').datepicker({
                dateFormat: 'dd-mm-yy',
                timeFormat: 'hh:mm:ss',
                minDate: currentDate,
                changeYear: true,
                changeMonth: true
            }).attr('readonly', 'readonly');

            $("#EngId").prop("disabled", true);
             document.getElementById("InspectionW").checked = true;
       
                $("#InspectionW").click(function () {
                debugger
                let InscheckedValue = $('#InspectionW:checked').val();

                if (InscheckedValue == "true")
                {
                    $("#EngId").prop("disabled", true);
                }
                else 
                {
                    $("#EngId").prop("disabled", false);
                }
                
            });
            $("#QtyUse").prop("disabled", true);
            $("#QtyAccRJ").change(function () {
                let QtyACpVl = $("#QtyAccRJ option:selected").val();
                if (QtyACpVl == "true") {
                    let QtyOffVl = $("#Qty_Offered").val();
                    $("#QtyUse").val(QtyOffVl);
                    $("#QtyUse").prop("disabled", true);
                }
                else if (QtyACpVl == "false") {
                    $("#QtyUse").val(0);
                    $("#QtyUse").prop("disabled", true);
                }
                else {
                    $("#QtyUse").val("");
                    $("#QtyUse").prop("disabled", false);
                }
            });
            $("#QtyUse").blur(function () {
                let QtyVl = $("#QtyUse").val();
                let QtyOffVl = $("#Qty_Offered").val();
                if (parseFloat(QtyVl) > parseFloat(QtyOffVl)) {
                    alert("Qty Should not greater then offered qty!")
                    $("#QtyUse").val("");
                }
                else {

                }
            });
        });
    </script>
}