@model IEnumerable<SUP_CORE.EFModel.EngineerMaster>

@{
    ViewBag.Title = "Engineer List";
}

<div id="content">
    <!-- Begin Page Content -->
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card border-0 mb-4">
            <div class="card-body">
                <p class="col-sm-2 border-left-primary bg-whiteDark" align="left" style="margin-top:10px;padding:5px;">
                    @Html.ActionLink("Create New", "Create", null, new { @class = "text-primary" })
                </p>

                <div class="table-responsive font">
                    <table class="table" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr class="text-nowrap" style="color:black">
                                <th>Actions</th>
                                <th>Name</th>
                                <th>Email ID</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="nowrap small">
                                    <td>
                                        @Html.ActionLink("Edit", "Edit", "EngineerMaster", new { id = item.Id }, new { @class = "badge badge-primary" }) |
                                        @Html.ActionLink("Delete", "Delete", "EngineerMaster", new { id = item.Id }, new { @class = "badge badge-danger" })
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.EmailId)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script>
        $(document).ready(function () {
            var table = $('#dataTable').DataTable({
                destroy: true,
                orderCellsTop: true,
                "columnDefs": [
                    { "width": "20%", "targets": 1 }

                ],
                "order": [[1, "desc"]],
                "lengthMenu": [[10, 15, 25, 50, 100, -1], [10, 15, 25, 50, 100, "All"]],
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        exportOptions: {
                            columns: [1, 2, 3]
                        },
                        filename: function () {
                            var d = new Date().toISOString().split('T')[0];
                            return 'EngineerSummary_' + d;
                        }
                    }
                ]
            });
        });
    </script>
}
