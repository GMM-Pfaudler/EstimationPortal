@{
    ViewBag.Title = "Create Engineer";
}
@using (Html.BeginForm("Create", "EngineerMaster", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
                </p>
            </div>
            <div class="card border-0 col-md-12">
                <div class="card-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="row  col-md-12">
                                                @Html.Label("Name", "Name", htmlAttributes: new { @class = "control-label " })
                                                <label class="text-danger control-label">*</label>
                                            </div>
                                            <div class="col-md-12 row">
                                                @Html.TextBox("Name", null, new { @id = "Name", @class = "form-control form-control-sm",@autocomplete="off" })
                                                @Html.ValidationMessage("Name", "", new { @class = "text-danger small font-weight-bold" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="row  col-md-12">
                                                @Html.Label("EmailId", "EmailId", htmlAttributes: new { @class = "control-label " })
                                                <label class="text-danger control-label">*</label>
                                            </div>
                                            <div class="col-md-12 row">
                                                @Html.TextBox("EmailId", null, new { @id = "EmailId",@type="Email", @class = "form-control form-control-sm", @autocomplete = "off" })
                                                @Html.ValidationMessage("EmailId", "", new { @class = "text-danger small font-weight-bold" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="row col-md-12">
                                                @Html.Label("Status", "Status", htmlAttributes: new { @class = "control-label" })
                                            </div>
                                            <div class="col-md-12 row">
                                                @Html.DropDownList("Status", new[]{
                                                       new SelectListItem(){ Text = "True",Value = "true",Selected = true },
                                                       new SelectListItem(){ Text = "False",Value ="false" },
                                                 }, null, new { @id = "Status", @class = "form-control form-control-sm font padding-drop" })

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group col-md-12">
            <div class="col-md-offset-2 col-md-12" align="center">
                <input type="submit" value="Create" class="btn btn-sm  btn-outline-primary col-sm-1 font" />
            </div>
        </div>
    </div>

}

