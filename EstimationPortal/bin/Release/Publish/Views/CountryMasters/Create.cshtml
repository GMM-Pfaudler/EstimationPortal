@model SUP_CORE.EFModel.CountryMaster

@{
    ViewBag.Title = "Create Country";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
                </p>
            </div>
            <div class="card border-0">
                <div class="card-body ">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="row  col-md-12">
                                    @Html.LabelFor(model => model.CountryName, htmlAttributes: new { @class = "control-label" })
                                    <label class="text-danger control-label">*</label>
                                </div>
                                <div class="col-md-12 row">
                                    @Html.EditorFor(model => model.CountryName, new { htmlAttributes = new { @class = "form-control form-control-sm", @autocomplete = "off" } })
                                    @Html.ValidationMessageFor(model => model.CountryName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="col-md-offset-2 col-md-12" align="center">
                    <input type="submit" value="Create" class="btn btn-sm  btn-outline-primary col-sm-1 font" />
                </div>
            </div>
        </div>
    </div>


}
