@model SUP_CORE.EFModel.CurrencyMaster

@{
    ViewBag.Title = "Delete Currency";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="content-wrapper">
    <div class="container-scroller">
        <div align="right">
            <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
            </p>
        </div>
        <div class="card border-0">
            <div class="card-body ">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Id)
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label col-md-12">Currency Name</label>
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.CurrencyName, new { htmlAttributes = new { @class = "form-control form-control-sm", @autocomplete = "off", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.CurrencyName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-group col-sm-12 m-md-2" align="center">
        <input type="submit" value="Delete" class="btn btn-sm  btn-outline-danger col-sm-1 font" />

    </div>
}
