@{
    ViewBag.Title = "Material SubContract List";
}

<div id="content">
    <!-- Begin Page Content -->
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card shadow mb-4  border-0">
            <div class="card-body bg-white">
                <div class="row">
                    <div class="col-md-12">
                        <label class="control-label font-weight-bold">Filters :</label>
                        <br />
                        <input type='text' id='search_wh' placeholder='WH' class="m-1">
                        <input type='text' id='search_PO' placeholder='PO' class="m-1">
                        <input type='text' id='search_POLN' placeholder='PO LN' class="m-1">
                        <input type='text' readonly id='search_podate' class="datepicker m-1" placeholder='PO date'>
                        <input type='text' readonly id='search_dlvrydate' class="datepicker m-1" placeholder='Delivery date'>
                        <input type='text' id='search_pitemcode' placeholder='Parent Item Code' class="m-1">
                        <input type='text' id='search_pitemtext' placeholder='Parent Item Text' class="m-1">
                        <input type='text' id='search_citemcode' placeholder='Child Item Code' class="m-1">
                        <input type='text' id='search_citemtext' placeholder='Child Item Text' class="m-1">
                        <input type='text' id='search_trfnotext' placeholder='TRF No' class="m-1">
                        <input type='text' id='search_dcnotext' placeholder='DC No' class="m-1">
                        <input type='text' id='search_shipnotext' placeholder='Shipment No' class="m-1">
                        <input type='text' id='search_bpcode' placeholder='BP Code' class="m-1">
                        <input type='text' id='search_bpname' placeholder='BP Name' class="m-1">
                        <input type='text' id='search_buyer' placeholder='Bayer Name' class="m-1">
                        <input type='text' id='search_drawing' placeholder='Drawing' class="m-1">
                        <input type='text' id='search_office' placeholder='Office' class="m-1">
                        <input type='button' id="btn_search" value="Search" class="btn btn-sm btn-outline-primary m-1" />
                        <input type='button' id="btn_clear" value="Clear" class="btn btn-sm btn-outline-secondary m-1">
                    </div>
                </div>
                <div class="table-responsive font">
                    <table id="demodata" class="table text-nowrap" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>WH</th>
                                <th>PO</th>
                                <th>LN</th> 
                                <th>Sequence</th>
                                <th>PO Date</th>
                                <th>Delivery Date</th>
                                <th>Parent Item Code</th>
                                <th>Parent Item Text</th>
                                <th>Unit Price</th>
                                <th>TTL Pending Price</th> 
                                <th>Order Qty</th>
                                <th>Received Qty</th>
                                <th>Pending Qty</th> 
                                <th>Child Item Code</th>
                                <th>Child Item Text</th>
                                <th>LN Satus</th>
                                <th>Required Qty</th>
                                <th>Unit</th>
                                <th>Qty to be Shipped</th>
                                <th>Delivered Qty</th>
                                <th>Pending Qty at Subcontractor</th>
                                <th>Transfer Type</th>
                                <th>Order Origin</th>
                                <th>TRF No</th>
                                <th>TRF LN</th>
                                <th>TRF Date</th>
                                <th>DC No</th>
                                <th>Shipment</th>
                                <th>Shipment LN</th>
                                <th>DC Date</th>
                                <th>No of days</th>
                                <th>BP Code</th>
                                <th>BP Name</th>
                                <th>Buyer Name</th>
                                <th>Office</th>
                                <th>Drawing</th>
                                <th>Rev</th>
                                <th>Drawing Download</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
