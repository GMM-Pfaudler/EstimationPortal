<script type="text/javascript">
                $(document).ready(function () {
                    debugger
                    $("#datepicker").datepicker({
                        dateFormat: "mm/yy",
                        changeMonth: true,
                        changeYear: true,
                        showButtonPanel: true,
                        onChangeMonthYear: function (year, month, inst) {
                            debugger
                            var selectedMonth = month;
                            var selectedYear = year;
                            var formattedDate = ('0' + selectedMonth).slice(-2) + '/' + selectedYear; // Format month and year (e.g., "01/2022")
                            $("#datepicker").val(formattedDate);
                            fetchDataByMonthYear(selectedMonth, selectedYear);

                        }

                    });
                });
                $("#datepicker").val("Select Month - Year");
                function fetchDataByMonthYear(month, year) {
                    $.ajax({
                        url: '@Url.Action("DataByMonthYear", "Home")',
                        type: 'GET',
                        data: { month: month, year: year },
                        success: function (response) {
                            debugger
                            // Handle the response
                            if (response.TotalList !== null && response.TotalList !== undefined) {
                                $("#vtlClass").text(response.TotalList);
                            } else {
                                $("#vtlClass").text("0");
                            }
                            if (response.PendingList !== null && response.PendingList !== undefined) {
                                $("#ptlClass").text(response.PendingList);
                            } else {
                                $("#ptlClass").text("0");
                            }
                            if (response.Allocated !== null && response.Allocated !== undefined) {
                                $("#acClass").text(response.Allocated);
                            } else {
                                $("#acClass").text("0");
                            }
                            if (response.Reworked !== null && response.Reworked !== undefined) {
                                $("#rdClass").text(response.Reworked);
                            } else {
                                $("#rdClass").text("0");
                            }
                            if (response.Approved !== null && response.Approved !== undefined) {
                                $("#appClass").text(response.Approved);
                            } else {
                                $("#appClass").text("0");
                            }
                            if (response.RejectedList !== null && response.RejectedList !== undefined) {
                                $("#rjList").text(response.RejectedList);
                            } else {
                                $("#rjList").text("0");
                            }
                        },
                        error: function (xhr, status, error) {
                            // Handle errors
                            console.error(xhr.responseText);
                        }
                    });
                }
</script>

