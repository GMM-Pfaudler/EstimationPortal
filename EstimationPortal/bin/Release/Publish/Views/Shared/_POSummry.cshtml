@model IEnumerable<SUP_CORE.DTO.QLT_PODTO>
    @{
    Layout = null;
    }


    <div class="table-responsive font">
        <table class="table table-bordered" id="dataTable2" width="100%" cellspacing="0">
            <thead>
                <tr class="text-wrap small">
                    <th> @Html.CheckBox("CheckAll", false, new { id = "CBox1" }) </th>
                    <th>Action</th>
                    <th>Status</th>
                    <th>IC No.</th>
                    <th>Office</th>
                    <th>WH</th>
                    <th>SO</th>
                    <th>BP Code</th>
                    <th>BP Name</th>
                    <th>PO</th>
                    <th>LN</th>
                    <th>Item Code</th>
                    <th>Item Description</th>
                    <th>Offered Qty</th>
                    <th>Buyer Code</th>
                    <th>Buyer Name</th>
                    <th>Drawing</th>
                    <th>Drw Rev.</th>
                    <th>QI Engineer Name</th>
                    <th>IC Rev.</th>
                    <th>Call Submited Date</th>
                    <th>Call Assigned Date</th>
                    <th>Inspection Planned Date</th>
                    <th>Call Attended Date</th>
                    <th>Rejection Reason</th>
                    <th>Supplier File</th>
                    <th>Supplier Remarks</th>
                    <th>QC Manager Remarks</th>
                    <th>QC Engineer Remarks</th>
                </tr>
            </thead>
            <tbody class="text-nowrap">
                @foreach (var item in Model)
                { int counter = 0;
                if ((item.Status != "Waiver") && (item.Status != "Accepted") && (item.Status != "Rejected"))
                {
                DateTime now = DateTime.Now;
                var styl = "";
                if (item.SuppOfferDate > now.AddHours(-72) && item.SuppOfferDate <= now|| item.SuppOfferDate==null)
                {
                styl = " text-transform: uppercase;";
                }
                else
                {
                styl = " text-transform: uppercase; Background-color : Yellow;";
                }


                <tr class="nowrap small" style="@styl">
                    @if ((item.Status == "Created") || (item.Status == "Rework"))
                    {
                    <td>
                        <input type="checkbox" class="checkBox" value="@item.Id" name="CBox" />
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "QLTOffrEdit", "PO", new { id = item.Id }, new { @class = "badge badge-primary" })
                        @if (item.Status != "Rework")
                        { @Html.ActionLink("Delete", "QLTOffrDelete", "PO", new { id = item.Id }, new { @class = "badge badge-danger" })   }

                        @Html.ActionLink("Submit", "QLTOffrSubmit", "PO", new { id = item.Id }, new { @class = "badge badge-primary" })
                    </td>
                    }
                    else
                    {
                    <td></td>
                    <td></td>
                    }
                    @if(item.Status == "Rework"){
                    <td><b id="Restatus">@Html.DisplayFor(modelItem => item.Status)</b></td>
                    }else if(item.Status == "Assigned" || item.Status == "Created"){
                    <td><b id="Assgstatus">@Html.DisplayFor(modelItem => item.Status)</b></td>
                    }else{
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    }

                    <td>@Html.DisplayFor(modelItem => item.CTNumbr)</td>
                    <td>@Html.DisplayFor(modelItem => item.Office)</td>
                    <td>@Html.DisplayFor(modelItem => item.Warehouse)</td>
                    <td>@Html.DisplayFor(modelItem => item.Sales_Order)</td>
                    <td>@Html.DisplayFor(modelItem => item.Supplier_ID)</td>
                    <td>@Html.DisplayFor(modelItem => item.BP_Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Order_Number)</td>
                    <td>@Html.DisplayFor(modelItem => item.Line_Number)</td>
                    <td>@Html.DisplayFor(modelItem => item.Item)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>@Html.DisplayFor(modelItem => item.Qty_Offered)</td>
                    <td>@Html.DisplayFor(modelItem => item.Buyer_Code)</td>
                    <td>@Html.DisplayFor(modelItem => item.Buyer)</td>
                    <td>@Html.DisplayFor(modelItem => item.Drawing_Number)</td>
                    <td>@Html.DisplayFor(modelItem => item.GMM_Drw_Rev)</td>
                    <td>@Html.DisplayFor(modelItem => item.QIEngineer)</td>
                    <td>@Html.DisplayFor(modelItem => item.Revision_Number)</td>
                    <td>@Html.DisplayFor(modelItem => item.SuppOfferDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.QAssignedDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.InspPlannedDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.EngAttendedDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.RReason)</td>
                    @if (item.GMM_Drw_Numbr != null)
                    {
                    <td>@Html.ActionLink("Download", "DownLoadFile", new { Doc = item.GMM_Drw_Numbr })</td>}
                    else
                    {
                    <td></td>}
                    <td>@Html.DisplayFor(modelItem => item.Supp_Remarks)</td>
                    <td>@Html.DisplayFor(modelItem => item.QLT_Remarks)</td>
                    <td>@Html.DisplayFor(modelItem => item.Remarks)</td>
                </tr>
                }

                }
            </tbody>
        </table>
    </div>
    <style>
        #Assgstatus {
            border-radius: 25px;
            background: #7ac745;
            padding: 3px;
            padding-left: 8px;
            padding-right: 8px;
            color: white;
        }

        #Restatus {
            border-radius: 25px;
            background: #032980;
            padding: 3px;
            padding-left: 8px;
            padding-right: 8px;
            color: white;
        }
    </style>
