@{
    ViewBag.Title = "Create Role";
}
@using (Html.BeginForm("Create", "RoleMaster", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
                </p>
            </div>
            <div class="card border-0 col-md-12">
                <div class="card-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <div class="row  col-md-12">
                                                @Html.Label("Role", "Role", htmlAttributes: new { @class = "control-label " })
                                                <label class="text-danger control-label">*</label>
                                            </div>
                                            <div class="col-md-12 row">
                                                @Html.TextBox("Role", null, new { @id = "Role", @class = "form-control form-control-sm" })
                                                @Html.ValidationMessage("Role", "", new { @class = "text-danger small font-weight-bold" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="form-group col-md-12">
            <div class="col-md-offset-2 col-md-12" align="center">
                <input type="submit" value="Create" class="btn btn-sm  btn-outline-primary col-sm-1 font" />
            </div>
        </div>
    </div>

}

