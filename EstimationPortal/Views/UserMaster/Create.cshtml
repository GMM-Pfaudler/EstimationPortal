    .field-icon {
        position: absolute;
        top: 30px;
        right: 15px;
        cursor: pointer;
        color: #6c757d;
    }
    /* Container styling */
    .order-form-container {
        background-color: #f8fafc; 
        min-vh: 100vh;
    }

    /* Custom Input Styling to fix misalignment */
    /*.custom-input {
        border: none !important;
        background-color: #f1f5f9 !important;
        border-radius: 8px !important;
        padding: 8px 10px !important;
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        transition: all 0.2s ease;
    }*/

        .custom-input:focus {
            background-color: #ffffff !important;
            box-shadow: 0 0 0 3px rgba(0, 51, 141, 0.1) !important;
            outline: 1px solid #00338d !important;
        }

    /* Checkbox Alignment */
    .custom-checkbox .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.15em;
        border-radius: 4px;
        cursor: pointer;
    }

        .custom-checkbox .form-check-input:checked {
            background-color: #00338d;
            border-color: #00338d;
        }

    /* Label Styling */
    .custom-field label {
        letter-spacing: 0.5px;
        font-size: 0.75rem;
        display: block;
    }

    /* Button Hover */
    .btn-primary:hover {
        filter: brightness(1.2);
        transform: translateY(-1px);
    }
</style>
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/css/EditProject.css" rel="stylesheet">
<div class="order-form-container">
    <div class="container-fluid py-4 px-lg-5">
        <div class="d-flex justify-content-between align-items-center page-header-container">
            <div class="PageHeading">
                <h2 class="fw-bold mb-1" style="color: var(--text-main);">@ViewBag.Title</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0" style="background:transparent; padding:0;">
                        <li class="breadcrumb-item text-muted">User  Master</li>
                        <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Create User</li>
                    </ol>
                </nav>
            </div>

            <a href="@Url.Action("Index","UserMaster")" class="btn-animate-back">
                <i class="fas fa-arrow-left"></i>
                <span>Back to List</span>
            </a>
        </div>
        <div class="card border-0 shadow-lg rounded-8 overflow-hidden" style="border-radius:15px;">
            @*<div class="card-header border-0 py-3" style="background: #00338d;">
            <h5 class="text-white mb-0 fw-bold"><i class="fas fa-user-plus me-2"></i> User Information</h5>
        </div>*@
            <div class="card-header border-0 py-3 bg-transparent">
                <span class="custom-tab">
                    <i class="fas fa-user-plus me-2"></i> User Information
                </span>
            </div>
            <div class="card-body p-4 p-lg-5 bg-white">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group custom-field">
                                <label class="small fw-bold text-muted mb-1 text-uppercase">User ID / Login ID</label>
                                @*@Html.EditorFor(model => model.UserID, new { htmlAttributes = new { @class = "form-control custom-input", autocomplete = "off", @placeholder = "e.g. NKB" } })*@
                                @Html.TextBox("UserID", null, new { @class = "form-control custom-input", autocomplete = "off", @placeholder = "e.g. NKB" })
                                @Html.ValidationMessage("UserID", "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group custom-field">
                                <label class="small fw-bold text-muted mb-1 text-uppercase">User Name</label>
                                @Html.TextBox("UserName", null, new { @class = "form-control custom-input", autocomplete = "off", @placeholder = "e.g. Nikhil Baridun" })
                                @Html.ValidationMessage("UserName", "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group custom-field">
                                <label class="small fw-bold text-muted mb-1 text-uppercase">Access Role</label>
                                @Html.DropDownList("RoleId", ViewBag.RoleId as List<SelectListItem>, "-- Select Role --", htmlAttributes: new { @class = "form-control custom-input" })
                                @Html.ValidationMessage("RoleId", "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group custom-field">
                                <label class="small fw-bold text-muted mb-1 text-uppercase">Email Address</label>
                                @Html.TextBox("EmailID", null, new { @class = "form-control custom-input", autocomplete = "off", @placeholder = "e.g. test@gmmpfaudler.com" })
                                @Html.ValidationMessage("EmailID", "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group custom-field">
                                <label class="small fw-bold text-muted mb-1 text-uppercase">Password</label>

                                @Html.TextBox("Password", null, new
                                {
                                   @class = "form-control custom-input pr-5",
                                   id = "passwordField",
                                   type = "password",
                                   autocomplete = "off"
                                })
                                <span toggle="#passwordField" class="fa fa-eye field-icon" id="togglePassword"></span>
                                @Html.ValidationMessage("Password", "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-12 mt-5 d-flex justify-content-end gap-2 pt-4 border-top">
                            <button type="reset" class="btn btn-light rounded-pill px-4 fw-bold text-bg-primary border" style="margin-right:10px;">Reset</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #00338d; border:none;">
                                <i class="fas fa-save me-2"></i> Save User
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById("togglePassword").addEventListener("click", function () {
        var input = document.getElementById("passwordField");

        if (input.type === "password") {
            input.type = "text";
            this.classList.remove("fa-eye");
            this.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            this.classList.remove("fa-eye-slash");
            this.classList.add("fa-eye");
        }
    });
</script>


