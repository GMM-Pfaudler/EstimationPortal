@model SUP_CORE.EFModel.RoleMasters
@{
    ViewBag.Title = "Delete Role";
}

@using (Html.BeginForm("RoleDelete", "UserMaster", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)


    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "RoleIndex", null, new { @class = "text-primary" })
                </p>
            </div>
            <div class="card border-0">
                <div class="card-body ">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="row  col-md-12">
                                    @Html.Label("RoleName", "RoleName", htmlAttributes: new { @class = "control-label " })
                                </div>
                                <div class="col-md-12 row">
                                    @Html.TextBoxFor(model => model.Role, new { @id = "RoleName", @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    
                </div>
            </div>

            <div class="form-group col-sm-12 m-md-2" align="center">
                <input type="submit" value="Delete" class="btn btn-sm  btn-outline-primary col-sm-1 font" />
            </div>
        </div>
    </div>

}


