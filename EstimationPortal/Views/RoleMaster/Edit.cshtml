@model SUP_CORE.EFModelViews.RoleAccessViewModel
@{
    ViewBag.Title = "Edit Role Details";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.RoleId)


    <div class="content-wrapper">
        <div class="container-scroller">
            <div align="right">
                <p class="col-sm-2 border-left-primary bg-white" align="left" style="margin-right:5px;padding:5px;">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "text-primary" })
                </p>
            </div>
            <div class="card border-0">
                <div class="card-body ">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <div class="row  col-md-12">
                                    @Html.Label("Role", htmlAttributes: new { @class = "control-label " })
                                    <label class="text-danger control-label">*</label>
                                </div>
                                <div class="col-md-12 row">
                                    @Html.TextBoxFor(model => model.Role, new { @class = "form-control form-control-sm" })
                                    @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @Html.HiddenFor(model => model.RoleId)
                        @for (int i = 0; i < Model.MainMenus.Count; i++)
                        {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">@Model.MainMenus[i].MenuName</h5>
                            </div>
                            <div class="card-body">
                                @Html.HiddenFor(m => m.MainMenus[i].MainMenuId)

                                @if (Model.MainMenus[i].SubMenus != null && Model.MainMenus[i].SubMenus.Any())
                                {
                                    <ul class="list-group list-group-flush">
                                        @for (int j = 0; j < Model.MainMenus[i].SubMenus.Count; j++)
                                        {
                                            <li class="list-group-item">
                                                <div class="form-check">
                                                    @Html.HiddenFor(m => m.MainMenus[i].SubMenus[j].SubMenuId)
                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           name="MainMenus[@i].SubMenus[@j].IsChecked"
                                                           value="true"
                                                           @(Model.MainMenus[i].SubMenus[j].IsChecked ? "checked" : "") />
                                                    <label class="form-check-label">
                                                        @Model.MainMenus[i].SubMenus[j].SubMenuName
                                                    </label>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>

            <div class="form-group col-sm-12 m-md-2" align="center">
                <input type="submit" value="Update" class="btn btn-sm  btn-outline-primary col-sm-1 font" />
            </div>
        </div>
    </div>

}



