                                <option value="@sp.Value" selected="@(ViewBag.SelectedProjStatus == sp.Value)">
                                    @sp.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit"
