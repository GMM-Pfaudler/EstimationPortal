                    </div>
                    <div class="col-md-2 mt-3">
                        <label class="form-label small fw-bold">Project Status</label>
                        <select id="ProjStatusId" name="ProjStatus" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.ProjStatusList)
