            <form method="get" class="container-fluid" id="filterForm">

                <div class="row g-3">

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Project</label>
                        <select id="ProjectNumber" name="ProjectNo" class="form-control form-control-custom">
                            <option value="">All Projects</option>
                            @foreach (var project in ViewBag.ProjectNoList)
                            {
                                <option value="@project.Value" selected="@(ViewBag.SelectedProjectNo == project.Value)">
                                    @project.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Inquiry Type</label>
                        <select id="InqTypeId" name="InqType" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.InqTypeList)
                            {
                                <option value="@sp.Value" selected="@(ViewBag.SelectedInqType == sp.Value)">
                                    @sp.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Dom / Exp</label>
                        <select id="DomExpId" name="DomExp" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.DomExpList)
                            {
                                <option value="@sp.Value" selected="@(ViewBag.SelectedDomExp == sp.Value)">
                                    @sp.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Enquiry Status</label>
                        <select id="EnqStatusId" name="EnqStatus" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.EnqStatusList)
                            {
                                <option value="@sp.Value" selected="@(ViewBag.SelectedEnqStatus == sp.Value)">
                                    @sp.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Due Date</label>
                        @Html.TextBox(
                            "DueDate",
                            null,
                            new
                                 {
                                name = "DueDate",
                                type = "date",
                                @class = "form-control custom-input"
                            })
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Thermal Engineer</label>
                        <select id="ThEid" name="ThEngg" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.TEList)
                            {
                                <option value="@sp.Value" selected="@(ViewBag.SelectedThEngg == sp.Value)">
                                    @sp.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mt-3">
                        <label class="form-label small fw-bold">Proposal Engineer</label>
                        <select id="PrEid" name="PrEngg" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.PEList)
                            {
                                <option value="@sp.Value" selected="@(ViewBag.SelectedPrEngg == sp.Value)">
                                    @sp.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mt-3">
                        <label class="form-label small fw-bold">Estimation Engineer</label>
                        <select id="EstEid" name="EstEngg" class="form-control form-control-custom">
                            <option value="">All</option>
                            @foreach (var sp in ViewBag.EEList)
                            {
                                <option value="@sp.Value" selected="@(ViewBag.SelectedEstEngg == sp.Value)">
