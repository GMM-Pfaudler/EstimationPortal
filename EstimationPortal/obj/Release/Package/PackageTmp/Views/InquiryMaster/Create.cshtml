<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
<script>
    $(document).ready(function () {
        $('#SalesPerson').select2({
            //placeholder: "-Select-",
            //allowClear: true,
            //width: '100%'
        });
        
        function checkStatus() {

            var dueDateVal = $('#DueDate').val();
            var actualSubDateVal = $('#ActualSubDate').val();

            // CASE 1: Completed
            if (actualSubDateVal !== '') {

                $('#EnqStatus').val(
                    $('#EnqStatus option').filter(function () {
                        return $(this).text().trim() === 'Completed';
                    }).val()
                );

                return;
            }

            // CASE 2: Overdue check
            if (dueDateVal !== '' && actualSubDateVal === '') {

                var dueDate = new Date(dueDateVal);
                dueDate.setHours(0, 0, 0, 0);

                var today = new Date();
                today.setHours(0, 0, 0, 0);

                if (dueDate < today) {

                    $('#EnqStatus').val(
                        $('#EnqStatus option').filter(function () {
                            return $(this).text().trim() === 'Overdue';
                        }).val()
                    );

                } else {

                    $('#EnqStatus').val('');
                }

                return;
            }

            // CASE 3: Default
            $('#EnqStatus').val('');
        }

        $('#DueDate').change(function () {
            checkStatus();
        });

        $('#ActualSubDate').change(function () {
            checkStatus();
        });

        

    
    });
    $(document).ready(function () {
        const $container = $('#toggleWrapper');
        const $checkbox = $('#IsMailTrigger');

        // Sync initial state on page load
        if ($checkbox.is(':checked')) {
            $container.addClass('active');
        }

        $container.on('click', function (e) {
            // Find the horizontal position of the click relative to the toggle box
            const containerWidth = $(this).outerWidth();
            const clickX = e.pageX - $(this).offset().left;

            // Determine if click happened on the left or right half
            if (clickX < containerWidth / 2) {
                // Clicked Left Side -> Force FALSE (OFF)
                setToggleState(false);
            } else {
                // Clicked Right Side -> Force TRUE (ON)
                setToggleState(true);
            }
        });

        function setToggleState(shouldBeActive) {
            // Only update if the state is actually changing
            if ($checkbox.is(':checked') !== shouldBeActive) {
                $checkbox.prop('checked', shouldBeActive).change(); // Notify ASP.NET

                if (shouldBeActive) {
                    $container.addClass('active');
                } else {
                    $container.removeClass('active');
                }
            }
        }
    });
    $(document).ready(function () {

        function toggleMailNotes() {
            if ($("#IsMailTrigger").is(":checked")) {
                $("#mailNotesDiv").slideDown();
            } else {
                $("#mailNotesDiv").slideUp();
                $("#MailNotes").val(""); // Clear textarea
            }
        }

        // Initial page load
        toggleMailNotes();

        // Toggle click
        $("#IsMailTrigger").change(function () {
            toggleMailNotes();
        });

    });
</script>

