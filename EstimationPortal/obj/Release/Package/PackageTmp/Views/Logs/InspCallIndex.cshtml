@model IEnumerable<SUP_CORE.DTO.TrsDTO>

@{
    ViewBag.Title = "Inspection Call Logs";
}

<div id="content">
    <!-- Begin Page Content -->
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card border-0 mb-4">
            <div class="card-body">
                <div class="table-responsive font">
                    <table class="table" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr class="text-nowrap" style="color:black">
                                <th>ID</th>
                                <th>ItemCode</th>
                                <th>SupplierName</th>
                                <th>Warehouse</th>
                                <th>Buyer</th>
                                <th>Tr No</th>
                                <th>Username</th>
                                <th>PO No</th>
                                <th>Line</th>
                                <th>Action Taken</th>
                                <th>Date</th>
                                <th>Role</th>
                                <th>Reject Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="nowrap small">
                                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Item)</td>
                                    <td>@Html.DisplayFor(modelItem => item.BP_Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Warehouse)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Buyer)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CTNumbr)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Order_Number)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Line_Number)</td>
                                    <td>@Html.DisplayFor(modelItem => item.ActionTaken)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Role)</td>
                                    <td>@Html.DisplayFor(modelItem => item.RReason)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script>
        $(document).ready(function () {
            // Setup - add a text input to each footer cell
            $('#dataTable thead tr').clone(true).appendTo('#dataTable thead');
            $('#dataTable thead tr:eq(1) th').each(function (i) {
                var title = $(this).text();
                debugger
                $(this).html('<input type="text" class="col-sm-6" placeholder="Search ' + title + '" />');

                $('input', this).on('keyup change', function () {
                    if (table.column(i).search() !== this.value) {
                        table
                            .column(i)
                            .search(this.value)
                            .draw();
                    }
                });
            });
            var table = $('#dataTable').DataTable({
                "order": [[0, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": [0] },
                    { "orderable": true, "targets": [1] }
                ],
                "lengthMenu": [[10, 15, 25, 50, 100, -1], [10, 15, 25, 50, 100, "All"]],
                dom: '<l>Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 7, 8]
                        },
                        filename: function () {
                            var d = new Date().toISOString().split('T')[0];
                            return 'PropsalSummary_' + d;
                        }
                    }
                ]
            });
        });
    </script>
}
