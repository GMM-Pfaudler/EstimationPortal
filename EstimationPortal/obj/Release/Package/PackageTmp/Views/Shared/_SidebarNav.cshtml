@{
    var pUserId = Convert.ToInt16(System.Web.HttpContext.Current.Session["ID"]);
    var RoleId = System.Web.HttpContext.Current.Session["RoleID"].ToString();
}

<style>
    :root {
        --primary-theme-color: #002D72;
        --profile-bg: rgba(255, 255, 255, 0.15);
    }

    #accordionSidebar {
        z-index: 1050 !important; /* Higher than standard Bootstrap components */
        display: flex !important;
        flex-direction: column !important;
        height: 100vh;
        position: sticky;
        top: 0;
    }

    .flex-grow-1 {
        flex-grow: 1 !important;
    }

    .sidebar-user-container {
        margin-top: auto;
        position: relative;

    }

    /* FIX: Open Upward and stay within sidebar width */
    .profile-dropdown-menu {
        position: absolute;
        bottom: 100% !important;
        top: auto !important;
        /* Matches sidebar width minus margins */
        width: calc(100% - 4px) !important;
        left: 3px !important;
        right: 10px !important;
        transform: none !important;
        margin-bottom: 10px !important;
        border-radius: 12px !important;
        padding: 10px 0;
        border: none !important;
        box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.2) !important;
        z-index: 1000;
        animation: slideUp 0.2s ease-out;
    }


    .profile-card {
        background: var(--profile-bg);
        border-radius: 8px;
        padding: 10px 12px !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: background 0.3s ease;
        color: white !important;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none !important;
        animation: slideUp 1s ease-out;
    }

        .profile-card:hover {
            background: rgba(255, 255, 255, 0.25);
        }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .profile-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
    }

        .profile-avatar-wrapper img {
            width: 32px;
            height: 32px; 
        }

    .online-status {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 10px;
        height: 10px;
        background-color: #1cc88a;
        border: 2px solid var(--primary-theme-color);
        border-radius: 50%;
    }

    .user-name-text {
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 110px; /* Prevents long names from breaking the layout */
    }

    .arrow-icon {
        font-size: 0.7rem;
        opacity: 0.7;
    }

    .dropdown-header {
        font-size: 0.65rem !important;
        font-weight: 800;
        letter-spacing: 1px;
        color: #b7b9cc !important;
        padding: 0.5rem 1.25rem !important;
    }

    .profile-dropdown-menu .dropdown-item {
        padding: 8px 15px;
        font-size: 0.85rem;
        color: #4e73df;
        display: flex;
        align-items: center;
    }

        .profile-dropdown-menu .dropdown-item:hover:not(.no-hover) {
            background-color: #f8f9fc;
            color: var(--primary-theme-color);
        }

    .theme-icon {
        width: 16px;
        margin-right: 12px;
        color: var(--primary-theme-color);
        text-align: center;
    }

    .time-text {
        color: #5a5c69;
        font-weight: 600;
        font-size: 0.85rem;
    }

     


    .btn-logout {
        background-color: var(--primary-theme-color) !important;
        border-color: var(--primary-theme-color) !important;
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 6px;
        color: white !important;
        margin-top: 5px;
    }

        .btn-logout:hover {
            filter: brightness(1.2);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    /* 4. Fix for graphs overlapping - apply to the container */
    .sidebar-user-container {
        margin-top: auto;
        position: relative;
        z-index: 1100 !important;
    }

    .bg-Blue {
        background-color: #032980;
        padding: 15px 10px 13px 10px;
        text-align: center;
    }

    .logo-separator {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        margin: 5px 25px 15px 25px;
    }

    .nav-item .nav-link {
        margin: 4px 12px !important; /* Creates space for the 'card' look */
        padding: 12px 15px !important;
        border-radius: 12px !important; /* Rounded corners for the card */
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        color: rgba(255, 255, 255, 0.8) !important;
        display: flex;
        align-items: center;
        border: 1px solid transparent;
    }

        /* THE GLASS CARD HOVER EFFECT */
        .nav-item .nav-link:hover {
            background: rgba(255, 255, 255, 0.12) !important; /* Subtle glass tint */
            backdrop-filter: blur(8px); /* Frosted effect */
            color: #ffffff !important;
            transform: translateX(5px); /* Subtle slide-out animation */
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2); /* Lifted shadow */
            border: 1px solid rgba(255, 255, 255, 0.15); /* Soft border highlight */
        }

            /* Icon Animation on Hover */
            .nav-item .nav-link:hover i {
                transform: scale(1.1);
                color: #ffffff !important;
            }

    
</style>
