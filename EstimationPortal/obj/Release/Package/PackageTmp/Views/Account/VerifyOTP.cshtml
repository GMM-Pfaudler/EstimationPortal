@using CaptchaMvc.HtmlHelpers
@using EstimationPortal.Models
@model VerifyOTP
@{

    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <!-- Custom fonts for this template-->
    <link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <!-- Custom styles for this template-->
    <link href="~/Content/css/sb-admin-2.css" rel="stylesheet">
    <script type="text/javascript">
        function preventBack() { window.history.forward(); }
        setTimeout("preventBack()", 0);
        window.onunload = function () { null };
    </script>
</head>

<body class="bg-gradient-primary" style="margin-top:50px;background-image:url(../../Images/bgimg_white_crystal.jpg)">
    <div class="container">
        <!-- Outer Row -->
        <div class="row justify-content-md-around my-4">
            <div class="col-xl-12 col-lg-5 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        @using (Html.BeginForm("VerifyOTP", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
                        {
                        <!-- Nested Row within Card Body -->
                            <div class="row">
                                <div class="col-lg-7 d-none d-lg-block bg-login-image"></div>
                                <div class="col-lg-5">
                                    <div class="p-5">
                                        <div class="row justify-content-center p-3"><img class="" src="~/Images/Logo_180X46.png" alt="lgCmpny"></div>
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="form-group">
                                            <div class="position-relative">
                                                <div class="card p-2 text-center">
                                                    <h6>Please enter the one time password <br> to verify your account</h6>
                                                    <div>
                                                        <span>A code has been sent to</span> <small>@Session["UserEmailId"]</small>
                                                    </div>
                                                    <div id="otp" class="inputs d-flex flex-row justify-content-center mt-2">
                                                        <input class="m-2 text-center form-control rounded" type="text" id="first" maxlength="1" name="first" autocomplete="off" />
                                                        <input class="m-2 text-center form-control rounded" type="text" id="second" maxlength="1" name="second" autocomplete="off" />
                                                        <input class="m-2 text-center form-control rounded" type="text" id="third" maxlength="1" name="third" autocomplete="off" />
                                                        <input class="m-2 text-center form-control rounded" type="text" id="fourth" maxlength="1" name="fourth" autocomplete="off" />
                                                        <input class="m-2 text-center form-control rounded" type="text" id="fifth" maxlength="1" name="fifth" autocomplete="off" />
                                                        <input class="m-2 text-center form-control rounded" type="text" id="sixth" maxlength="1" name="sixth" autocomplete="off" />
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-12">
                                                            <div class="input-group mb-3">
                                                                @Html.MathCaptcha()
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="mt-4">
                                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                                            Verify
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="text-center mb-1">
                                            <a class="small text-success" href="/Account/Login">Already have an account? Login!</a>
                                        </div>
                                        <div class="text-center">
                                            <a class="small text-primary" href="#">For support contact in case any technical issue: <u>notification@gmmpfaudler.com</u></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

